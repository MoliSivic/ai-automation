# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
venv/
.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp
.pytest_cache/
__pycache__/
*.py[cod]

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!frontend/.env.example
!backend/.env.example

# local backend generated files
/backend/storage/uploads/*
/backend/storage/inbox/*
/backend/storage/exports/*
!/backend/storage/uploads/.gitkeep
!/backend/storage/inbox/.gitkeep
!/backend/storage/exports/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
